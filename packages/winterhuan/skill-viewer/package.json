{
  "name": "@winterhuan/dsh-skill-viewer",
  "description": "Read-only skill catalog and body Remote for the skill viewer",
  "version": "0.1.5-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-skill-viewer.git",
    "directory": "packages/winterhuan/skill-viewer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@winterhuan/dsh-client-ui-skill-viewer": "git+https://github.com/winterhuan/dsh-client-ui-skill-viewer.git#791c6632bb8ed7e9f6bdc2a3401a5b2e0e0caaf1&path:/packages/winterhuan/ui-skill-viewer",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "homepage": "https://github.com/winterhuan/dsh-skill-viewer#readme"
}
